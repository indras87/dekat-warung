erDiagram
    users {
        string id PK
        string nama
        string email
        string noHp
        string role
        datetime createdAt
    }

    warungs {
        string id PK
        string ownerId FK
        string namaWarung
        float latitude
        float longitude
        boolean isOpen
        boolean isDeliveryAvailable
        int deliveryFee
        boolean acceptCash
        boolean acceptQris
        string qrisImageUrl
    }

    categories {
        string id PK
        string warungId FK
        string nama
    }

    products {
        string id PK
        string warungId FK
        string categoryId FK
        string nama
        int harga
        boolean isAvailable
    }

    orders {
        string id PK
        string orderNumber
        string warungId FK
        string buyerId FK
        string buyerName
        string status
        string serviceType
        string paymentMethod
        string customNote
        int totalAmount
        datetime createdAt
    }

    order_items {
        string id PK
        string orderId FK
        string productId FK
        string productName
        int price
        int quantity
    }

    users ||--o| warungs : "owns"
    users ||--o{ orders : "places"
    warungs ||--o{ categories : "has"
    warungs ||--o{ products : "sells"
    warungs ||--o{ orders : "receives"
    categories ||--o{ products : "contains"
    orders ||--o{ order_items : "contains"
    products ||--o{ order_items : "referenced in"