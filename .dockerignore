# Version control
.git
.gitignore

# Dependencies (re-installed inside the image)
node_modules
**/node_modules

# Next build output (re-built inside the image)
.next
out

# Local DB & env (must come from compose env, not the image)
.env
.env*.local
prisma/dev.db
prisma/dev.db-journal

# Generated artifacts not needed at runtime
graphify-out
*.md
!README.md

# Docker meta
Dockerfile
.dockerignore

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.tsbuildinfo
