# Dekat Warung — environment
# MVP ships SQLite so `npm run dev` works zero-config (prisma db push creates dev.db).
# To switch to PostgreSQL (production), set provider "postgresql" in prisma/schema.prisma
# and use a URL like the one below:
# DATABASE_URL="postgresql://user:password@localhost:5432/dekat_warung?schema=public"

DATABASE_URL="file:./dev.db"
