# Dekat Warung — environment
#
# Production/containerized stack uses PostgreSQL (matches CLAUDE.md).
# `docker compose up` provisions its own Postgres and sets DATABASE_URL for the
# app container — you do NOT need to set it manually for Docker.
#
# For LOCAL non-Docker dev:
#   1. Start only the DB:   docker compose up -d db
#   2. Copy this file to .env and use the localhost URL below.
DATABASE_URL="postgresql://dekat:dekat@localhost:5432/dekat_warung?schema=public"

# To run on SQLite instead: set provider="sqlite" in prisma/schema.prisma and use
# DATABASE_URL="file:./dev.db"  (then `npm run db:setup`)

# Session (iron-session) - minimum 32 characters
SESSION_SECRET="change_this_to_a_secure_random_string_min_32_characters"
SESSION_COOKIE_NAME="dw-session"
