// Dekat Warung — Prisma schema
// Stack per CLAUDE.md: PostgreSQL. Provider defaults to SQLite so the MVP runs
// zero-config (`npm run db:setup`). Flip `provider` to "postgresql" + a real
// DATABASE_URL for production — models are provider-agnostic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Enums (Prisma emulates these for SQLite) -------------------------------

enum Role {
  ADMIN
  PEMBELI
  WARUNG
}

enum OrderStatus {
  PENDING
  DIPROSES
  SIAP
  SELESAI
  BATAL
}

enum ServiceType {
  PICKUP
  ANTERIN
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

// ---- Models -----------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  nama      String
  email     String?  @unique
  noHp      String?
  role      Role     @default(PEMBELI)
  warung    Warung?
  orders    Order[]
  createdAt DateTime @default(now())

  @@map("users")
}

model Warung {
  id                  String   @id @default(cuid())
  ownerId             String   @unique
  owner               User     @relation(fields: [ownerId], references: [id])
  namaWarung          String
  latitude            Float
  longitude           Float
  isOpen              Boolean  @default(true)
  isDeliveryAvailable Boolean  @default(true)
  deliveryFee         Int      @default(2000)
  acceptCash          Boolean  @default(true)
  acceptQris          Boolean  @default(false)
  acceptTransfer      Boolean  @default(false)
  qrisImageUrl        String?
  whatsappNumber      String?
  categories          Category[]
  products            Product[]
  orders              Order[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("warungs")
}

model Category {
  id        String  @id @default(cuid())
  warungId  String
  warung    Warung  @relation(fields: [warungId], references: [id], onDelete: Cascade)
  nama      String
  products  Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  warungId    String
  warung      Warung   @relation(fields: [warungId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  nama        String
  harga       Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([warungId])
  @@map("products")
}

model Order {
  id            String       @id @default(cuid())
  orderNumber   String       @unique
  warungId      String
  warung        Warung       @relation(fields: [warungId], references: [id])
  buyerId       String?
  buyer         User?        @relation(fields: [buyerId], references: [id])
  buyerName     String
  status        OrderStatus  @default(PENDING)
  serviceType   ServiceType
  paymentMethod PaymentMethod
  customNote    String?
  subtotal      Int          @default(0)
  deliveryFee   Int          @default(0)
  totalAmount   Int          @default(0)
  items         OrderItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([warungId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  price       Int
  quantity    Int

  @@map("order_items")
}
